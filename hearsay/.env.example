# Copy to .env and fill in. Nothing here is required to boot the server —
# with no keys at all the app runs on stub embeddings and cached propagations,
# which is what keeps the demo alive if the venue wifi dies.

# Required for real Grok calls. https://console.x.ai
XAI_API_KEY=

# Optional. Without it, embeddings fall back to a deterministic hash stub.
OPENAI_API_KEY=

# Model overrides (defaults shown)
GROK_REASON_MODEL=grok-4-6
GROK_FAST_MODEL=grok-4-fast-non-reasoning

# low | medium | high | xhigh   (cannot be disabled on grok-4-6)
REASONING_EFFORT=high

PORT=3000
